apiVersion: v1
kind: Namespace
metadata:
  name: ani-cutover-current
  labels:
    cutover-fitness-id: CF-01
    run-id: @@RUN_ID@@
---
apiVersion: v1
kind: Namespace
metadata:
  name: ani-cutover-target
  labels:
    cutover-fitness-id: CF-01
    run-id: @@RUN_ID@@
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: cf01-registry-pull-canary
  namespace: ani-cutover-current
  labels:
    cutover-fitness-id: CF-01
    run-id: @@RUN_ID@@
spec:
  selector:
    matchLabels:
      app: cf01-registry-pull-canary
      run-id: @@RUN_ID@@
  template:
    metadata:
      labels:
        app: cf01-registry-pull-canary
        cutover-fitness-id: CF-01
        run-id: @@RUN_ID@@
    spec:
      tolerations:
        - operator: Exists
      containers:
        - name: probe
          image: @@PROBE_IMAGE@@
          imagePullPolicy: Always
          args: ["sleep", "--seconds", "14400"]
          resources:
            requests: {cpu: 5m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
      restartPolicy: Always
